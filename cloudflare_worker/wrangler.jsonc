{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mga-cloud-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-27",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SERVICE_NAME": "mga-cloud-sync-worker"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mga-cloud-db",
      "database_id": "71ab7072-021a-4da3-bc99-d751d82877ec"
    }
  ]
}

